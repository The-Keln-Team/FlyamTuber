<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>app.ico</ApplicationIcon>

		<Product>FlyamTuber</Product>
		<AssemblyTitle>FlyamTuber</AssemblyTitle>
		<Company>The Keln Team</Company>
		<Authors>The Keln Team</Authors>
		<Copyright>The Keln Team</Copyright>
		<Description>Программа для PNGTuber: переключает изображения персонажа по громкости голоса и выводит его в OBS.</Description>

		<Version>1.1.0</Version>
		<AssemblyVersion>1.1.0.0</AssemblyVersion>
		<FileVersion>1.1.0.0</FileVersion>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="app.ico" />
		<Resource Include="app.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="NAudio" Version="3.1.0" />
	</ItemGroup>

</Project>