<Window x:Class="FlyamTuber.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlyamTuber V 1.1 — The Keln Team" Height="860" Width="1320"
        Background="#141319" Foreground="#F2F0EE"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F0EE"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9B95A6"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B79BFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#26242E"/>
            <Setter Property="Foreground" Value="#F2F0EE"/>
            <Setter Property="BorderBrush" Value="#3A3745"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1D1C23"/>
            <Setter Property="Foreground" Value="#F2F0EE"/>
            <Setter Property="BorderBrush" Value="#3A3745"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F2F0EE"/>
        </Style>

        <!-- Тёмная полоса прокрутки: стандартная светлая, своей разметки у неё нет -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Body" Background="#3A3745" CornerRadius="4" Margin="3,2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#55506B"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#B79BFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvisibleButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="#17161C">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InvisibleButton}"
                                                  Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InvisibleButton}"
                                                  Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="FlyamTuber" FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="V 1.1" Foreground="#8A8493" FontSize="11"
                       VerticalAlignment="Center" Margin="0,3,16,0"/>

            <TextBlock Text="Профиль" Foreground="#9B95A6" VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <ComboBox x:Name="ProfileBox" Width="170" Height="28" VerticalAlignment="Center"
                      DisplayMemberPath="Name" SelectionChanged="ProfileBox_SelectionChanged"/>
            <Button Content="Новый" Click="NewProfile_Click" Margin="6,0,0,0"/>
            <Button Content="Переименовать" Click="RenameProfile_Click"/>
            <Button Content="Удалить" Click="DeleteProfile_Click"/>

            <Border Width="1" Background="#2A2833" Margin="10,2,12,2"/>

            <Button Content="Загрузить набор PNG…" Click="LoadSet_Click"/>
            <Button Content="+ уровень" Click="AddLevel_Click"/>
            <Button Content="− уровень" Click="RemoveLevel_Click"/>
            <Button Content="Пороги поровну" Click="AutoSpread_Click"/>
            <CheckBox x:Name="MirrorBox" Content="Отзеркалить" VerticalAlignment="Center"
                      Margin="8,0,0,0" Click="Mirror_Click"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="УРОВНИ (сверху вниз = тише к громче)"
                           Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                <ListBox x:Name="LevelsList" Background="#17161C" Foreground="#E7E4EA"
                         BorderBrush="#2A2833"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         DisplayMemberPath="Display"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="LevelsList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="LevelsList_PreviewMouseMove"
                         DragOver="LevelsList_DragOver"
                         Drop="LevelsList_Drop"
                         SelectionChanged="LevelsList_SelectionChanged"/>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="ПРЕДПРОСМОТР"
                           Style="{StaticResource Caption}"/>
                <Border BorderBrush="#2A2833" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <Border.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#1A191F">
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,2,2"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="#131218">
                                        <GeometryDrawing.Geometry>
                                            <GeometryGroup>
                                                <RectangleGeometry Rect="0,0,1,1"/>
                                                <RectangleGeometry Rect="1,1,1,1"/>
                                            </GeometryGroup>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Border.Background>

                    <Grid x:Name="PreviewArea" Background="Transparent"
                          SizeChanged="PreviewArea_SizeChanged"
                          MouseLeftButtonDown="PreviewArea_MouseDown"
                          MouseMove="PreviewArea_MouseMove"
                          MouseLeftButtonUp="PreviewArea_MouseUp">

                        <!-- Весь персонаж целиком: эффекты двигают этот слой -->
                        <Grid x:Name="CharacterLayer" Margin="12" RenderTransformOrigin="0.5,0.9">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CharScale" ScaleX="1" ScaleY="1"/>
                                    <RotateTransform x:Name="CharRotate" Angle="0"/>
                                    <TranslateTransform x:Name="CharTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <Image x:Name="PreviewImageOld" Stretch="Uniform" Opacity="0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Image x:Name="PreviewImage" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Image x:Name="BlinkHalf" Stretch="Uniform" Opacity="0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Image x:Name="BlinkClosed" Stretch="Uniform" Opacity="0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>

                        <Canvas x:Name="EyeCanvas" Margin="12" IsHitTestVisible="False">
                            <Rectangle x:Name="EyeRect" Stroke="#B79BFF" StrokeThickness="1.5"
                                       StrokeDashArray="4 3" Visibility="Collapsed"/>
                        </Canvas>

                        <TextBlock x:Name="PreviewHint"
                                   Text="Нажмите «Загрузить набор PNG…» и выберите все кадры сразу"
                                   Foreground="#8A8493" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   MaxWidth="320"/>

                        <Border Background="#CC0E0D11" BorderBrush="#2E2B38" BorderThickness="1"
                                CornerRadius="6" Padding="10,7"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12">
                            <StackPanel>
                                <TextBlock x:Name="StateText" Text="Состояние: —" FontWeight="SemiBold"/>
                                <TextBlock x:Name="StateSub" Text="" Foreground="#CFCAD6"
                                           FontFamily="Consolas" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CalibBar" Background="#F2141319" BorderBrush="#B79BFF"
                                BorderThickness="1" CornerRadius="10" Padding="26,18"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="CalibTitle" Text="" FontSize="22" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="CalibHint" Text="" Foreground="#CFCAD6"
                                           Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="CalibCount" Text="" FontSize="34" FontWeight="Bold"
                                           Foreground="#B79BFF" HorizontalAlignment="Center"
                                           Margin="0,10,0,0" FontFamily="Consolas"/>
                                <Button Content="Отмена" Click="CalibrateCancel_Click"
                                        HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="EyeHintBar" Background="#E6B79BFF" CornerRadius="6"
                                Padding="12,7" HorizontalAlignment="Center" VerticalAlignment="Top"
                                Margin="12" Visibility="Collapsed">
                            <TextBlock Text="Обведите мышью область глаз прямо на персонаже"
                                       Foreground="#17151E" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>
            </DockPanel>

            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,10,0">

                    <TextBlock Text="НАСТРОЙКИ УРОВНЯ" Style="{StaticResource Section}"/>

                    <TextBlock Text="Название" Style="{StaticResource Caption}"/>
                    <TextBox x:Name="NameBox" LostFocus="LevelField_LostFocus"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Включение, %" Style="{StaticResource Caption}"/>
                            <TextBox x:Name="OnBox" LostFocus="LevelField_LostFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Выключение, %" Style="{StaticResource Caption}"/>
                            <TextBox x:Name="OffBox" LostFocus="LevelField_LostFocus"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="ShakeBox" Content="Трясти на этом уровне"
                              Margin="0,12,0,0" Click="ShakeBox_Click"/>

                    <TextBlock x:Name="FileText" Text="—" Foreground="#8A8493"
                               FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <Button Content="Выбрать PNG…" Click="PickImage_Click" Margin="0,8,0,0"
                            HorizontalAlignment="Left"/>

                    <Separator Margin="0,18,0,14" Background="#2A2833"/>

                    <TextBlock Text="СМЕНА РТА" Style="{StaticResource Section}"/>
                    <CheckBox x:Name="SharpTransitionBox" Content="Резкая, без плавного перехода"
                              Click="SharpTransition_Click"/>
                    <StackPanel Width="110" HorizontalAlignment="Left" Margin="0,10,0,0">
                        <TextBlock Text="Длит., мс" Style="{StaticResource Caption}"/>
                        <TextBox x:Name="TransitionMsBox" Text="120" LostFocus="EffectField_LostFocus"/>
                    </StackPanel>

                    <Separator Margin="0,18,0,14" Background="#2A2833"/>

                    <TextBlock Text="ДРОЖАНИЕ" Style="{StaticResource Section}"/>
                    <CheckBox x:Name="ShakeEnabledBox" Content="Включено" IsChecked="True"
                              Click="EffectToggle_Click"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Сила, px" Style="{StaticResource Caption}"/>
                            <TextBox x:Name="ShakeAmpBox" Text="5" LostFocus="EffectField_LostFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Скорость" Style="{StaticResource Caption}"/>
                            <TextBox x:Name="ShakeSpeedBox" Text="20" LostFocus="EffectField_LostFocus"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Начать при, %" Style="{StaticResource Caption}"/>
                            <TextBox x:Name="ShakeOnBox" Text="85" LostFocus="EffectField_LostFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Прекратить, %" Style="{StaticResource Caption}"/>
                            <TextBox x:Name="ShakeOffBox" Text="72" LostFocus="EffectField_LostFocus"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Галочка «трясти» у уровня включает дрожание независимо от этих порогов."
                               Foreground="#8A8493" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>

                    <Separator Margin="0,18,0,14" Background="#2A2833"/>

                    <TextBlock Text="ПОДПРЫГИВАНИЕ И НАКЛОН" Style="{StaticResource Section}"/>
                    <CheckBox x:Name="BounceEnabledBox" Content="Подпрыгивать в такт речи" IsChecked="True"
                              Click="EffectToggle_Click"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Высота, px" Style="{StaticResource Caption}"/>
                            <TextBox x:Name="BounceHeightBox" Text="18" LostFocus="EffectField_LostFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Упругость" Style="{StaticResource Caption}"/>
                            <TextBox x:Name="BounceStiffBox" Text="90" LostFocus="EffectField_LostFocus"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="TiltEnabledBox" Content="Покачивание" Margin="0,12,0,0"
                              Click="EffectToggle_Click"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Градусы" Style="{StaticResource Caption}"/>
                            <TextBox x:Name="TiltDegBox" Text="3" LostFocus="EffectField_LostFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Скорость" Style="{StaticResource Caption}"/>
                            <TextBox x:Name="TiltSpeedBox" Text="2.5" LostFocus="EffectField_LostFocus"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,18,0,14" Background="#2A2833"/>

                    <TextBlock Text="МОРГАНИЕ" Style="{StaticResource Section}"/>

                    <CheckBox x:Name="BlinkEnabledBox" Content="Включено" IsChecked="True"
                              Click="BlinkEnabled_Click"/>

                    <TextBlock Text="Кадр «полузакрытые глаза»" Style="{StaticResource Caption}" Margin="0,12,0,6"/>
                    <TextBlock x:Name="HalfFileText" Text="не загружен" Foreground="#8A8493"
                               FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                    <Button Content="Выбрать…" Click="PickHalf_Click" Margin="0,6,0,0"
                            HorizontalAlignment="Left"/>

                    <TextBlock Text="Кадр «закрытые глаза»" Style="{StaticResource Caption}" Margin="0,12,0,6"/>
                    <TextBlock x:Name="ClosedFileText" Text="не загружен" Foreground="#8A8493"
                               FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                    <Button Content="Выбрать…" Click="PickClosed_Click" Margin="0,6,0,0"
                            HorizontalAlignment="Left"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="От, с" Style="{StaticResource Caption}"/>
                            <TextBox x:Name="BlinkMinBox" Text="3" LostFocus="BlinkField_LostFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="До, с" Style="{StaticResource Caption}"/>
                            <TextBox x:Name="BlinkMaxBox" Text="7" LostFocus="BlinkField_LostFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Длит., мс" Style="{StaticResource Caption}"/>
                            <TextBox x:Name="BlinkDurBox" Text="170" LostFocus="BlinkField_LostFocus"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="SharpBlinkBox" Content="Резкое, без плавного перехода"
                              Margin="0,12,0,0" Click="SharpBlink_Click"/>

                    <TextBlock Text="Область глаз" Style="{StaticResource Caption}" Margin="0,16,0,6"/>
                    <TextBlock x:Name="EyeRegionText" Text="—" Foreground="#8A8493"
                               FontFamily="Consolas" FontSize="11"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="SetEyeButton" Content="Задать областью" Click="SetEyeRegion_Click"/>
                        <Button Content="Моргнуть" Click="BlinkNow_Click"/>
                    </StackPanel>
                    <CheckBox x:Name="ShowEyeRectBox" Content="Показывать рамку"
                              Margin="0,10,0,0" Click="ShowEyeRect_Click"/>

                    <Separator Margin="0,18,0,14" Background="#2A2833"/>

                    <TextBlock Text="ВЫВОД ДЛЯ OBS" Style="{StaticResource Section}"/>
                    <CheckBox x:Name="OverlayEnabledBox" Content="Включить вывод"
                              Click="OverlayToggle_Click"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Порт" Style="{StaticResource Caption}"/>
                            <TextBox x:Name="OverlayPortBox" Text="8752" LostFocus="OverlayPort_LostFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <Button Content="Копировать адрес" Click="CopyOverlayUrl_Click"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="OverlayUrlText" Text="выключено" Foreground="#8A8493"
                               FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>

                    <TextBlock Text="В OBS: Источники → Браузер → вставить адрес. Фон прозрачный, хромакей не нужен."
                               Foreground="#8A8493" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"/>

                    <Separator Margin="0,20,0,14" Background="#2A2833"/>

                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                        <TextBlock Text="FlyamTuber V 1.1" Foreground="#9B95A6" FontSize="11"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="The Keln Team" Foreground="#B79BFF" FontSize="12"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Устройство ввода" Style="{StaticResource Caption}"/>
                <ComboBox x:Name="DeviceBox" Height="28" DisplayMemberPath="FriendlyName"
                          SelectionChanged="DeviceBox_SelectionChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock x:Name="GainLabel" Text="Чувствительность — 1.0x"
                           Style="{StaticResource Caption}"/>
                <Slider x:Name="GainSlider" Minimum="0.5" Maximum="5" Value="1" Height="28"
                        ValueChanged="GainSlider_ValueChanged"/>
                <Button x:Name="CalibrateButton" Content="Настроить автоматически"
                        Click="Calibrate_Click" Margin="0,8,0,0" HorizontalAlignment="Left"/>
            </StackPanel>

            <StackPanel Grid.Column="4">
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Уровень громкости" Foreground="#9B95A6"/>
                    <TextBlock x:Name="LevelText" Text="0 %" HorizontalAlignment="Right"
                               FontFamily="Consolas" FontSize="14"/>
                </Grid>
                <Border Height="18" Background="#24222C" CornerRadius="5">
                    <Rectangle x:Name="MeterFill" Width="0" Fill="#B79BFF"
                               HorizontalAlignment="Left" RadiusX="5" RadiusY="5"/>
                </Border>
                <TextBlock x:Name="StatusText" Text="" Foreground="#8A8493"
                           FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
